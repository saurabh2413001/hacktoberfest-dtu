# Option A (free): Gemma 4 through Google AI Studio. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key

# Option B: DigitalOcean serverless inference (needs a DigitalOcean account)
# MODEL_ACCESS_KEY=sk-do-xxxxxxxx

# Optional overrides. Defaults: Gemma 4 for Option A, Llama 3.3 70B for Option B.
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_NO_SYSTEM=1     # set if your model rejects system prompts (this is also tried automatically)
