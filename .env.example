# Create a Model Access Key in the DigitalOcean control panel (Gradient AI > Serverless inference)
MODEL_ACCESS_KEY=sk-do-xxxxxxxxxxxxxxxx

# Optional. Defaults shown. List the models your key can use with:
#   curl https://inference.do-ai.run/v1/models -H "Authorization: Bearer $MODEL_ACCESS_KEY"
LLM_MODEL=llama3.3-70b-instruct
LLM_BASE_URL=https://inference.do-ai.run/v1
